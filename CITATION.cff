    given-names: "Abdul Abner"
    email: alugo@ipl.edu.do
    affiliation: "Instituto Especializado de Estudios Superiores Loyola, Dirección de Postgrado y Formación Profesional. San Cristóbal, República Dominicana"
license: MIT
version: "1.0.0"
date-released: "2026-11-21"
keywords:
  - diferencias finitas miméticas
  - equidistribución
  - adaptación de malla
  - supraconvergencia
  - método de de Boor
  - GNU Octave
